{
  "name": "soon-log",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:egg": "EXPO_PUBLIC_APP_NAME=SOON-EGG EXPO_PUBLIC_APP_SCHEME=soonegg EXPO_PUBLIC_EGG_CREATOR_BUILD=true EXPO_PUBLIC_EGG_API_URL=https://egg.sooncreator.network EXPO_PUBLIC_SUPABASE_URL=https://ycqribpphvywibamtjew.supabase.co expo start",
    "open:ios": "open ios/SOONLOG.xcworkspace",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-expo-autolinking.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.0",
    "@expo-google-fonts/dm-serif-display": "^0.4.0",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@supabase/supabase-js": "^2.49.8",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.0",
    "expo-share-intent": "4.1.2",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-maps": "1.20.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@expo/plist": "^0.7.0",
    "@react-native-community/cli": "^18.0.1",
    "@types/react": "~19.0.10",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3",
    "xmlbuilder": "^15.1.1"
  },
  "expo": {
    "autolinking": {
      "apple": {
        "searchPaths": [
          "../node_modules"
        ]
      },
      "ios": {
        "searchPaths": [
          "./node_modules"
        ]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-markdown-display",
          "base64-arraybuffer"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
