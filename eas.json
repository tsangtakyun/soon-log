      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "egg-preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "SOON-EGG",
        "EXPO_PUBLIC_APP_SCHEME": "soonegg",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.theirstudio.sooncreatorlog",
